GEMINI_API_KEY=your_api_key_here
LOG_LEVEL=INFO

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Leave unset/commented to run against local SQLite (recommended for first run).
# DATABASE_URL=sqlite:///./derivinsightnew.db
#
# Uncomment and fill in your own MySQL/RDS credentials to use a remote database.
# NEVER commit a real credential here — treat any value found in VCS history as compromised.
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>

# ── JWT AUTHENTICATION ────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * ONLY for local development.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# InsightOS Scheduler Settings
# Default domain for scheduled insight generation
DEFAULT_DOMAIN=retail_clothing
# Scheduler check interval in minutes (how often to run auto-insight detection rules)
SCHEDULER_INTERVAL_MINUTES=60
# Enable/Disable Insights API endpoints
ENABLE_INSIGHTS_API=True

# Redis / AWS Valkey (optional; used by alert engine and worker registry)
# Option A: Full URL (use rediss:// for TLS, e.g. AWS ElastiCache Valkey)
# REDIS_URL=rediss://:YOUR_AUTH_TOKEN@your-cluster.xxxxx.cache.amazonaws.com:6379/0
# Option B: Build from parts (uncomment and set REDIS_HOST for AWS Valkey)
# REDIS_HOST=your-cluster.xxxxx.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=YOUR_AUTH_TOKEN
# REDIS_USE_SSL=true
# REDIS_DB=0
# Default (no env set): redis://localhost:6379/0

# ── AUTOMATED LIVE DATA SYNCHRONIZATION ───────────────────────────────────────
# 1. Tally ERP 9 / TallyPrime Auto Sync
TALLY_SYNC_ENABLED=true
TALLY_AUTO_SYNC_ENABLED=true
TALLY_HOST=localhost
TALLY_PORT=9000
# TALLY_COMPANY=Your Company Name
# TALLY_EXPORT_FOLDER=D:/tally_exports
TALLY_SYNC_INTERVAL_MINUTES=60
LIVE_DATA_DIR=live_data

# 2. Google Sheets Live Sync
GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEET_ID=your_google_sheet_id_here
# GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=30

# 3. Shared Network Folder Sync
NETWORK_FOLDER_ENABLED=false
# NETWORK_FOLDER_PATH=\\server\shared\live_data
NETWORK_FOLDER_SYNC_INTERVAL_MINUTES=5
